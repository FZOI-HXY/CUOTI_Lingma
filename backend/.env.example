# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=True

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=cuoti_system

# OCR配置
OCR_LANG=ch
OCR_USE_GPU=False
OCR_DET_THRESH=0.5
OCR_REC_THRESH=0.8

# 文件存储
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
MAX_FILE_SIZE=10485760

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=./logs

# CORS配置
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
