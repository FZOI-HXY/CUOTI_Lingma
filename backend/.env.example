# 服务器配置
HOST=0.0.0.0
PORT=8100
DEBUG=True

# 数据库配置 - SQLite(默认,无需安装)
DB_FILE=cuoti_system.db

# 如果使用MySQL,注释上面的DB_FILE,取消下面注释
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=cuoti_system

# OCR配置
OCR_LANG=ch
OCR_USE_GPU=False
OCR_DET_THRESH=0.5
OCR_REC_THRESH=0.8

# PaddleOCR-VL-1.6 增强模式（可选）
VL_ENABLED=False
VL_SERVER_PORT=8101
VL_SERVER_HOST=0.0.0.0
VL_CTX_SIZE=4096
VL_THREADS=0
VL_STARTUP_TIMEOUT=120
# 模型目录（按实际路径修改）
# VL_MODEL_DIR=E:\Program Files\PP_Models\official_models\PaddlePaddle\PaddleOCR-VL-1___6-GGUF
# llama-cpp 目录（留空则自动推断 tools/llama-cpp/）
# VL_LLAMA_CPP_DIR=

# 文件存储
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
MAX_FILE_SIZE=10485760

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=./logs

# CORS配置
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API认证密钥（留空则不启用认证，用于开发环境）
API_KEY=
